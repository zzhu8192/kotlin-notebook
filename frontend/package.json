{
  "name": "kotlin-notebook-vendor",
  "private": true,
  "description": "Builds the vendored browser bundle in src/main/resources/static/vendor (npm install && npm run build) and runs the end-to-end test (npm run e2e, after ./gradlew installDist).",
  "scripts": {
    "build": "esbuild vendor.js --bundle --format=esm --minify --legal-comments=none --outfile=../src/main/resources/static/vendor/vendor.js",
    "e2e": "node --test --test-timeout=300000 e2e/notebook.e2e.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2",
    "marked": "18.1.1",
    "playwright": "1.64.1"
  }
}
